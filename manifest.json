{
  "manifest_version": 3,
  "name": "Network Monitor",
  "version": "1.1.3",
  "description": "Локальный мониторинг сетевых запросов текущей вкладки для анализа веб-приложений и API. Все данные остаются на устройстве пользователя.",
  "author": "Telegram @sequencedev",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Network Monitor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/overlay.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "debugger",
    "storage",
    "downloads",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "110"
}
